{
  "name": "glueful/thallo-importers",
  "description": "Thallo content format importers (CSV / Markdown / WordPress) as a removable capability pack.",
  "type": "glueful-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Michael Tawiah Sowah",
      "email": "michael@glueful.dev"
    }
  ],
  "version": "0.1.0",
  "require": {
    "php": "^8.3",
    "glueful/thallo-contracts": "*",
    "glueful/framework": "^1.64.0",
    "glueful/import-export": "^1.1.1",
    "glueful/users": "^2.3.0",
    "glueful/aegis": "^1.14.0",
    "league/commonmark": "^2.8",
    "symfony/html-sanitizer": "^7.0 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "Thallo\\Importers\\": "src/"
    }
  },
  "extra": {
    "glueful": {
      "provider": "Thallo\\Importers\\ImportersServiceProvider"
    }
  },
  "minimum-stability": "stable"
}
